# Modelo do .env — copie para ".env" e preencha.
# O .env real NUNCA vai para o Git (regra 15.4) e nunca entra em planilha.

# ---------------------------------------------------------------------------
#  PostgreSQL da Vórtx — somente SELECT (regra 15.9)
# ---------------------------------------------------------------------------
#  É um Azure Database for PostgreSQL: SSL é obrigatório e o servidor só aceita
#  IP liberado no firewall. A máquina do Calil já está liberada; outra máquina
#  precisa ser adicionada à regra (pendência 14.2-2).
PGHOST=netz-database-server.postgres.database.azure.com
PGPORT=5432
PGDATABASE=sor
PGUSER=carlos_hojaij
PGPASSWORD=
PGSSLMODE=require
PGTIMEOUT=20

# ---------------------------------------------------------------------------
#  API de Cobranças da Grafeno — Fase 5, somente leitura
# ---------------------------------------------------------------------------
#  A conta ainda não foi liberada (pendência 14.2-3). Ao criar o token em
#  Configurações → Tokens de API, marcar SÓ o escopo de Cobranças em modo
#  leitura e SÓ a conta da Leve Saúde — sem "dar acesso a todas as contas
#  futuras". Enquanto isso, a interface usa a fonte "Arquivo".
GRAFENO_TOKEN=
GRAFENO_ACCOUNT_NUMBER=
